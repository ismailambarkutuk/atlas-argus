# Varsayılan güvenli mod: emir hazırlanır, loglanır ama GÖNDERİLMEZ.
DRY_RUN=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ATLAS_MODEL=claude-haiku-5-5
ARGUS_MODEL=
LLM_TIMEOUT_MS=45000
AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Yalnızca bu iş için açılmış, içinde sadece testnet AVAX olan cüzdan
AVAX_PRIVATE_KEY=
# selftx | local
SEAL_PROVIDER=selftx
CHAIN_TIMEOUT_MS=60000
TOTAL_BUDGET_USDT=1000
MAX_PER_TRADE_USDT=100
MAX_DAILY_LOSS_USDT=50
ALLOWED_PAIRS=BTC-USDT,ETH-USDT
KILL_SWITCH=0
# Azaltma emrinde eldeki varlığın en fazla satılacak oranı (0-1)
REDUCE_FRACTION=0.25
# Uyum "yüksek" için iki agent'ın da ulaşması gereken güven
MIN_CONFIDENCE=0.7
# İstatistik penceresi (mum sayısı)
STATS_WINDOW=60
